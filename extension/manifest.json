{
  "manifest_version": 3,
  "name": "DragonShot — Asistente de tiro",
  "version": "0.1.1",
  "description": "Overlay de origen, destino, trayectoria y potencia para DragonBound. No automatiza el disparo.",
  "minimum_chrome_version": "111",
  "permissions": [],
  "host_permissions": [
    "https://dragonbound.net/*",
    "https://*.dragonbound.net/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DragonShot — mostrar/ocultar panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dragonbound.net/*",
        "https://*.dragonbound.net/*"
      ],
      "js": [
        "src/auto-calibration.js",
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dragonbound.net/*",
        "https://*.dragonbound.net/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
